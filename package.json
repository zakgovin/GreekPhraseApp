{
  "name": "greek-phrase-app",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "prebuild": "node scripts/check-media.mjs",
    "media:check": "node scripts/check-media.mjs",
    "android:build": "node scripts/build-android.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write src tests *.ts *.json *.md docs/*.md scripts/*.mjs",
    "format:check": "prettier --check src tests *.ts *.json *.md docs/*.md scripts/*.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-fsrs": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
